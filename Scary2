-- ============================================================
-- 9) Auto-fallback
-- ============================================================
local frameTimes: {number} = {}
local drops = 0

local function onRender(dt: number)
    table.insert(frameTimes, dt)
    if #frameTimes > 60 then table.remove(frameTimes, 1) end
    if not CONFIG.AutoAdjust or #frameTimes < 40 then return end

    local sum = 0
    for _, t in ipairs(frameTimes) do sum = sum + t end
    local fps = #frameTimes / sum

    if fps < CONFIG.MinAcceptableFPS and drops < CONFIG.MaxDrops then
        drops += 1
        safe(function()
            settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
        end)
        log(("auto-drop → Level01 (fps=%.0f)"):format(fps))
    end
end

-- ============================================================
-- 10) Public API
-- ============================================================
local API = {}
function API.GetFPS(): number
    if #frameTimes == 0 then return 0 end
    local sum = 0
    for _, t in ipairs(frameTimes) do sum = sum + t end
    return math.floor(#frameTimes / sum)
end
function API.GetPing(): number
    local ok, p = pcall(function()
        return Stats.Network.ServerStatsItem["Data Ping"]:GetValue()
    end)
    return ok and p or 0
end
function API.SetQuality(lvl: number)
    CONFIG.QualityLevel = math.clamp(lvl, 1, 10)
    safe(function()
        settings().Rendering.QualityLevel =
            Enum.QualityLevel["Level0"..CONFIG.QualityLevel]
    end)
end
function API.RestoreCull()
    for d in pairs(culledSet) do
        if d.Parent then d.Enabled = origStates[d] ~= false end
    end
    table.clear(culledSet); table.clear(origStates)
end

RunService.RenderStepped:Connect(onRender)
RunService.Heartbeat:Connect(cullStep)

log("initialized, quality =", CONFIG.QualityLevel)
return API
