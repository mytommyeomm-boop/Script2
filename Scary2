    QualityLevel     = 1,        -- 1..10  (Level01 = ต่ำสุด)
    MeshPartDetail   = 1,        -- 1..4
    StreamingRadius  = 512,
    GlobalShadows    = false,    -- ปลอดภัย: cutscene ไม่ tween ตัวนี้

